<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/card_medicamento_bg"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/imgMedicamentoIcono"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_analgesico"
            app:tint="#0D47A1" />

        <TextView
            android:id="@+id/txtNombre"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#0D47A1"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- ÁREA DE FAVORITO MEJORADA -->
        <LinearLayout
            android:id="@+id/btnFavoritoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_favorito_selector"
            android:minWidth="60dp"
            android:minHeight="50dp">

            <ImageView
                android:id="@+id/btnEstrella"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/btn_star_big_off"
                android:duplicateParentState="true" />

            <TextView
                android:id="@+id/txtFavoritoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardar"
                android:textSize="10sp"
                android:textColor="#5b3ff1"
                android:textStyle="bold"
                android:duplicateParentState="true"/>

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/txtDosis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#666666"
        android:textSize="10sp"
        android:layout_marginBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/txtDetallesLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Detalles >"
        android:textColor="#5b3ff1"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>