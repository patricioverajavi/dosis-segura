<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/btnRegresar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="start"
        android:layout_marginBottom="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#2c3359" />

    <ImageView
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/icon_button_bg"
        android:padding="18dp"
        android:src="@android:drawable/ic_menu_my_calendar"
        app:tint="#5b3ff1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Perfil de Usuario"
        android:textColor="#2c3359"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_medicamento_bg"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Completo"
            android:textColor="#777777"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtPerfilNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patricio Vera"
            android:textColor="#2c3359"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correo Electrónico"
            android:textColor="#777777"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtPerfilCorreo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="usuario@correo.com"
            android:textColor="#2c3359"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de Acceso"
            android:textColor="#777777"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtPerfilAcceso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuario Autenticado"
            android:textColor="#5b3ff1"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardEstadisticas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_medicamento_bg"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="#FFCC00" />

        <LinearLayout
            android:id="@+id/cardMisFavoritos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis Favoritos"
                android:textColor="#2c3359"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicamentos guardados en tu cuenta"
                android:textColor="#777777"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Botón principal (Cerrar Sesión / Iniciar Sesión) -->
    <Button
        android:id="@+id/btnAccionSesion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#FF3B30"
        android:text="Iniciar Sesión"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#FF3B30"
        android:text="Cerrar Sesión"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />
</LinearLayout>